{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node scripts/build-admin.mjs",
  "outputDirectory": "dist/admin-vercel",
  "redirects": [
    { "source": "/", "destination": "/admin/", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/admin/config",
      "destination": "https://amr-fan-app.onrender.com/admin/config"
    },
    {
      "source": "/v1/session",
      "destination": "https://amr-fan-app.onrender.com/v1/session"
    },
    {
      "source": "/v1/me",
      "destination": "https://amr-fan-app.onrender.com/v1/me"
    },
    {
      "source": "/v1/admin/session",
      "destination": "https://amr-fan-app.onrender.com/v1/admin/session"
    },
    {
      "source": "/v1/admin/points/profiles",
      "destination": "https://amr-fan-app.onrender.com/v1/admin/points/profiles"
    },
    {
      "source": "/v1/admin/points/adjustments",
      "destination": "https://amr-fan-app.onrender.com/v1/admin/points/adjustments"
    },
    {
      "source": "/v1/admin/profiles/:id/points/history",
      "destination": "https://amr-fan-app.onrender.com/v1/admin/profiles/:id/points/history"
    },
    {
      "source": "/v1/admin/rewards/offers",
      "destination": "https://amr-fan-app.onrender.com/v1/admin/rewards/offers"
    },
    {
      "source": "/v1/admin/submissions",
      "destination": "https://amr-fan-app.onrender.com/v1/admin/submissions"
    },
    {
      "source": "/v1/admin/submissions/:id/decision",
      "destination": "https://amr-fan-app.onrender.com/v1/admin/submissions/:id/decision"
    },
    {
      "source": "/v1/submissions/ranking",
      "destination": "https://amr-fan-app.onrender.com/v1/submissions/ranking"
    },
    {
      "source": "/v1/admin/submission-sessions",
      "destination": "https://amr-fan-app.onrender.com/v1/admin/submission-sessions"
    },
    {
      "source": "/v1/admin/submission-sessions/:id/close",
      "destination": "https://amr-fan-app.onrender.com/v1/admin/submission-sessions/:id/close"
    },
    {
      "source": "/v1/admin/submission-selections/:id/resolve",
      "destination": "https://amr-fan-app.onrender.com/v1/admin/submission-selections/:id/resolve"
    },
    {
      "source": "/v1/impact/official",
      "destination": "https://amr-fan-app.onrender.com/v1/impact/official"
    },
    {
      "source": "/v1/admin/reports",
      "destination": "https://amr-fan-app.onrender.com/v1/admin/reports"
    },
    {
      "source": "/v1/admin/reports/:id",
      "destination": "https://amr-fan-app.onrender.com/v1/admin/reports/:id"
    },
    {
      "source": "/v1/admin/reports/:id/source",
      "destination": "https://amr-fan-app.onrender.com/v1/admin/reports/:id/source"
    },
    {
      "source": "/v1/admin/reports/:id/candidates",
      "destination": "https://amr-fan-app.onrender.com/v1/admin/reports/:id/candidates"
    },
    {
      "source": "/v1/admin/reports/:id/extractions",
      "destination": "https://amr-fan-app.onrender.com/v1/admin/reports/:id/extractions"
    },
    {
      "source": "/v1/admin/report-candidates/:id/revisions",
      "destination": "https://amr-fan-app.onrender.com/v1/admin/report-candidates/:id/revisions"
    },
    {
      "source": "/v1/admin/report-candidates/:id/decisions",
      "destination": "https://amr-fan-app.onrender.com/v1/admin/report-candidates/:id/decisions"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self' https://folakoxsilrfemctvlxj.supabase.co; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
