# Production API image. Keep this separate from server/api/Dockerfile, which is
# intentionally a disposable DAST target that installs PostgreSQL.
FROM node:24.20.0-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e

ENV NODE_ENV=production \
    API_HOST=0.0.0.0 \
    API_PORT=8080 \
    AMR_ROUTES_PROVIDER=disabled \
    LUNA_REPORT_EXTRACTION_ENABLED=false \
    LAYA_ADVISORY_ENABLED=false

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN corepack enable \
  && pnpm install --frozen-lockfile --prod --ignore-scripts \
  && pnpm store prune

# Node 24's built-in TypeScript stripping runs the API sources directly. The
# runtime image contains only the server and the route calculation modules used
# by those sources; no Expo application bundle is copied into the image.
COPY --chown=node:node server ./server
COPY --chown=node:node src/features/routes ./src/features/routes

USER node
EXPOSE 8080

CMD ["node", "server/api/start.ts"]
