{
  "expo": {
    "name": "AMR Fan",
    "slug": "amr-fan-app",
    "version": "0.1.0",
    "icon": "./assets/branding/fan-icon-v1.png",
    "ios": {
      "bundleIdentifier": "xyz.theynr.amrfanapp"
    },
    "android": {
      "package": "xyz.theynr.amrfanapp",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "permissions": ["android.permission.RECEIVE_BOOT_COMPLETED"]
    },
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": ["ios", "android"],
    "scheme": "amrfan",
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow AMR Fan to take a photo of your activity.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow AMR Fan to record your location during a journey you start.",
          "locationAlwaysAndWhenInUsePermission": "Allow AMR Fan to keep recording your journey when the screen is locked or the app is in the background.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ]
  }
}
