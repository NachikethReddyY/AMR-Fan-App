NODE_ENV=development
API_HOST=REPLACE_WITH_BB1_TAILSCALE_ADDRESS
API_PORT=18080
DATABASE_URL=postgresql://amr_api:REPLACE_WITH_THE_SAME_VALUE_AS_THE_DB_SECRET@127.0.0.1:15432/amr

# Supabase is selected explicitly, but no provider credential is bundled here.
# Add the reviewed server-side auth values before exposing authenticated routes.
AUTH_PROVIDER=supabase

# AI inference remains off until a reviewed loopback gateway is installed.
LUNA_BASE_URL=http://127.0.0.1:8317/v1
LUNA_REPORT_EXTRACTION_ENABLED=false
LAYA_BASE_URL=http://127.0.0.1:55434
LAYA_ADVISORY_ENABLED=false
