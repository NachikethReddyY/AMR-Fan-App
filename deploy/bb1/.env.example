NODE_ENV=production
API_HOST=REPLACE_WITH_BB1_LAN_ADDRESS
API_PORT=18080
# Supabase PostgreSQL session-pooler URL. Keep the password in BB-1's private
# environment file or secret manager, never in this checkout.
DATABASE_URL=postgresql://amr_api.PROJECT_REF:REPLACE_WITH_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# The native apps use Entra External ID authorization-code + PKCE.
# Keep these public identity metadata values aligned with the app's OIDC config.
AUTH_PROVIDER=oidc
AUTH_ISSUER=https://9dcdff78-04a7-49fc-90bd-e9c7b76e4774.ciamlogin.com/9dcdff78-04a7-49fc-90bd-e9c7b76e4774/v2.0
AUTH_AUDIENCE=f278be1f-21a5-455b-bb14-b2fc60373939
AUTH_JWKS_URL=https://amrfancustomers.ciamlogin.com/9dcdff78-04a7-49fc-90bd-e9c7b76e4774/discovery/v2.0/keys
# Server-side `scp` claim value. The native client requests the full
# `api://.../account.access` scope URI; Entra emits only `account.access` here.
AUTH_REQUIRED_SCOPE=account.access

# Private host files are mounted read-only at /run/secrets/amr-private.
# Create /home/bb-1/.auth on BB-1 with mode 700 before starting Compose.
# Switch routing providers here without changing app code: onemap, google, disabled.
AMR_ROUTES_PROVIDER=onemap
# Per-mode OneMap deadline. The live demo host raises it because Singapore
# transit responses regularly exceed the 3000 ms default.
AMR_ROUTES_TIMEOUT_MS=4000
# Process-local OneMap call ceilings. The demo host tolerates repeated planning
# better than the committed 60/minute and 1000/provider-lifetime defaults.
AMR_ONEMAP_WINDOW_CALLS=240
AMR_ONEMAP_TOTAL_CALLS=5000
# OneMap credentials may be supplied by /home/bb-1/.auth/amr-onemap.env.
# The app accepts ONEMAP_EMAIL plus ONEMAP_EMAIL_PASSWORD (account login), or
# ONEMAP_EMAIL plus ONEMAP_API_KEY / ONEMAP_APIKKEY (existing access token).
# The JSON file path remains supported when you prefer a file over env values.
# AMR_ONEMAP_CREDENTIALS_FILE=/run/secrets/amr-private/amr-onemap.json

# Supabase Storage is optional and server-only. Use only for approved retained
# report originals; raw activity photos are never persisted.
REPORT_STORAGE_PROVIDER=supabase
# SUPABASE_STORAGE_KEY must be supplied privately on BB-1 when report storage is enabled.

# AI inference remains off until a reviewed loopback gateway is installed.
LUNA_BASE_URL=http://127.0.0.1:8317/v1
LUNA_REPORT_EXTRACTION_ENABLED=false
LAYA_BASE_URL=http://127.0.0.1:55434
LAYA_ADVISORY_ENABLED=false

# Reviewed AI activity assessment through the server-only TokenRouter gateway.
# The key and base URL are supplied through /home/bb-1/.auth/amr-ai.env.
ACTIVITY_ASSESSMENT_PROVIDER=tokenrouter
ACTIVITY_ASSESSMENT_ENABLED=true
