{
  "name": "amr-fan-app",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.13.0 <25",
    "pnpm": "12.x"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "agents:check": "node scripts/check-agents.mjs",
    "test:tooling": "node --test --test-concurrency=1 scripts/*.test.mjs",
    "security:secrets": "node scripts/security.mjs secrets",
    "security:sast": "node scripts/security.mjs sast",
    "security:audit": "pnpm audit --audit-level high",
    "security:self-test": "node scripts/security.mjs self-test",
    "security:check": "pnpm security:secrets && pnpm security:sast && pnpm security:audit && pnpm security:self-test",
    "security:dast": "node scripts/security.mjs dast",
    "security:dast:self-test": "node scripts/security.mjs dast-self-test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm test:tooling && pnpm agents:check && pnpm test:web && pnpm test:database:unit && pnpm ai:test && pnpm account:test && pnpm route:test && pnpm journey:test && pnpm submissions:test && pnpm rewards:test && pnpm reports:test && pnpm awards:test && pnpm participation:test",
    "test:web": "jest --config jest.web.config.js --runInBand",
    "test:database:unit": "node --test server/database/config.test.ts",
    "db:up": "node scripts/local-db.mjs up",
    "db:provision": "node scripts/local-db.mjs provision",
    "db:migrate": "node scripts/local-db.mjs migrate",
    "db:seed": "node scripts/local-db.mjs seed",
    "db:status": "node scripts/local-db.mjs status",
    "db:reset-test": "node scripts/local-db.mjs reset-test",
    "db:test": "node scripts/local-db.mjs test",
    "db:restart": "node scripts/local-db.mjs restart",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:run": "node scripts/local-db.mjs run",
    "db:run-test": "node scripts/local-db.mjs run-test",
    "db:verify": "node scripts/local-db.mjs verify",
    "ai:test": "node --test --test-concurrency=1 server/ai/*.test.ts",
    "ai:evaluate": "node server/ai/evaluation/run.ts",
    "account:test": "node --test server/auth/*.test.ts",
    "account:test:database": "pnpm db:run-test -- node --test --test-concurrency=1 server/accounts/*.test.ts server/api/app.test.ts",
    "route:test": "node --test --test-concurrency=1 server/routes/*.test.ts",
    "route:test:database": "pnpm db:run-test -- node --test --test-concurrency=1 server/api/routes.test.ts",
    "api:start": "node server/api/start.ts",
    "points:test:database": "pnpm db:run-test -- node --test server/points/*.test.ts",
    "journey:test": "node --test server/journeys/evidence.test.ts",
    "journey:test:database": "pnpm db:run-test -- node --test --test-concurrency=1 server/journeys/store.test.ts server/journeys/http.test.ts",
    "rewards:test": "node --test server/rewards/http.test.ts",
    "rewards:test:database": "pnpm db:run-test -- node --test --test-concurrency=1 server/rewards/*.test.ts server/rewards/testing/registered-api.test.ts",
    "submissions:test": "node --test server/submissions/http.test.ts",
    "submissions:test:database": "pnpm db:run-test -- node --test server/submissions/submissions.test.ts",
    "reports:test": "node --test --test-concurrency=1 server/reports/contracts.test.ts server/reports/extraction.test.ts server/reports/disabled.test.ts",
    "reports:test:native": "node --test --test-concurrency=1 server/reports/parser.test.ts server/reports/parser-boundaries.test.ts",
    "reports:test:container": "node --test --test-concurrency=1 server/reports/parser-container.test.ts",
    "reports:test:database": "pnpm db:run-test -- node --test --test-concurrency=1 server/reports/reports.test.ts server/reports/http.test.ts server/reports/registration.test.ts server/reports/integration.test.ts server/reports/storage.test.ts",
    "reports:parser:build": "docker build --tag amr-report-parser:local -f server/reports/Dockerfile .",
    "awards:test": "node --test server/awards/policy.test.ts",
    "awards:test:database": "pnpm db:run-test -- node --test --test-concurrency=1 server/awards/awards.test.ts server/awards/http.test.ts server/awards/testing/registered-api.test.ts",
    "participation:test": "node --test --test-concurrency=1 server/submissions/participation-contracts.test.ts server/submissions/participation-http.test.ts server/submissions/participation/admin/assets.test.ts server/submissions/participation/admin/app.test.mjs",
    "participation:test:database": "pnpm db:run-test -- node --test --test-concurrency=1 server/submissions/participation.test.ts server/submissions/participation/admin/read.database.test.ts server/submissions/participation-http.database.test.ts server/submissions/participation/admin/registration.database.test.ts"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo/html-elements": "^57.0.0",
    "@gluestack-ui/core": "^5.0.15",
    "@gluestack-ui/utils": "^5.0.6",
    "@legendapp/motion": "^2.5.3",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "expo": "~57.0.25",
    "expo-auth-session": "~57.0.13",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "jose": "6.2.2",
    "lucide-react-native": "^1.48.0",
    "nativewind": "5.0.0-rc.0",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",
    "react": "19.2.3",
    "react-aria": "^3.52.1",
    "react-native": "0.86.3",
    "react-native-css": "3.1.0-rc.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "react-stately": "^3.50.0",
    "tailwind-variants": "^0.1.20",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jest": "^29.5.14",
    "@types/pg": "8.23.1",
    "@types/react": "~19.2.2",
    "@types/react-dom": "19.2.3",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.6.2",
    "react-dom": "19.2.3",
    "react-native-web": "0.21.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
