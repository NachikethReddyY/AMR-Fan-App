# The phone calls the API. Never put a database/provider secret in EXPO_PUBLIC_*.
# Set this only after the backend owner supplies its reachable API endpoint.
EXPO_PUBLIC_API_URL=

# Optional public HTTPS override for the separately hosted news RSS XML.
# Blank uses the verified Azure feed. Its current deployment is manual; updates
# are not scheduled yet. No provider secret belongs here.
EXPO_PUBLIC_NEWS_FEED_URL=

# Server-only deployment configuration. Local pnpm db:run supplies DATABASE_URL
# from ~/.auth without writing credentials into a worktree or terminal output.
# Production uses a provisioned PostgreSQL URL and verified TLS, never local roles.
DATABASE_URL=
NODE_ENV=development

# Server-only names for the owning API/AI tasks. AI endpoints are loopback only.
API_HOST=127.0.0.1
API_PORT=
ADMIN_ORIGIN=
# Optional second exact origin for the deployed admin web app; no preview wildcard.
ADMIN_ADDITIONAL_ORIGIN=
LUNA_BASE_URL=
LUNA_API_KEY=
LAYA_BASE_URL=

# Quality gates failed on synthetic holdouts. Enable only for scoped revalidation.
LUNA_REPORT_EXTRACTION_ENABLED=false
LAYA_ADVISORY_ENABLED=false

# Private absolute directory outside repository/webroot, mode0700; originals0600.
REPORT_STORAGE_ROOT=
# native supports local macOS; docker uses a prebuilt immutable offline child image.
REPORT_PARSER_MODE=native
REPORT_PARSER_IMAGE=

# OIDC access-token verification. Provider/tenant values require provisioning.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
AUTH_REQUIRED_SCOPE=
# Explicit loopback development only; production rejects true.
AUTH_DEV_ENABLED=false

# Singapore-first server provider. No assigned credential file means disabled.
# Other choices: google (existing adapter), disabled. No automatic fallback.
AMR_ROUTES_PROVIDER=onemap
# Absolute path to an assigned external mode-600 JSON file with email/password.
# Never place its contents in source, EXPO_PUBLIC_* or shell history.
AMR_ONEMAP_CREDENTIALS_FILE=
# Alternative: private single-token file; leave email/password configuration empty.
# Both fields required. Cutoff must be an ISO timestamp with Z or an explicit offset.
# Operator use-until deadline, not verified provider expiry. No automatic renewal.
# Replace token and cutoff together, then restart. Dispatch stops 60 seconds early.
AMR_ONEMAP_ACCESS_TOKEN_FILE=
AMR_ONEMAP_ACCESS_TOKEN_EXPIRES_AT=
# Opt-in hosted api:start:onemap copies fixed /etc/secrets/amr-onemap-access-token.txt.
# Leave ACCESS_TOKEN_FILE unset with that command; stage first with provider=disabled.
AMR_ONEMAP_BASE_URL=https://www.onemap.gov.sg

# Preserved server-only Google adapter, selected explicitly with provider=google.
AMR_GOOGLE_ROUTES_KEY=
AMR_GOOGLE_ROUTES_ENDPOINT=https://routes.googleapis.com/directions/v2:computeRoutes
AMR_ROUTES_TIMEOUT_MS=3000
# Test-only loopback fixture switch. Production must leave false.
AMR_ROUTES_SYNTHETIC=false

# Choose supabase for the fixed folakoxsilrfemctvlxj project; default remains oidc.
# Leave generic AUTH_* issuer/audience/JWKS/scope overrides empty with supabase.
AUTH_PROVIDER=oidc
# Browser-safe new publishable key only; never a service-role/secret/legacy JWT.
SUPABASE_PUBLISHABLE_KEY=
# Defaults to local; supabase requires the exact private amr-report-originals bucket.
REPORT_STORAGE_PROVIDER=local
# Server-only legacy service_role JWT for the fixed project, never EXPO_PUBLIC_*.
SUPABASE_STORAGE_KEY=
# Public native app identifiers, never provider or server secrets.
EXPO_PUBLIC_AUTH_ISSUER=
EXPO_PUBLIC_AUTH_CLIENT_ID=
EXPO_PUBLIC_AUTH_API_SCOPE=
EXPO_PUBLIC_AUTH_REDIRECT_URI=
# Local synthetic UI is additionally gated by __DEV__.
EXPO_PUBLIC_LOCAL_SIGN_IN=false
