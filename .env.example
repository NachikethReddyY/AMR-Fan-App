# The phone calls the API. Never put a database/provider secret in EXPO_PUBLIC_*.
# Set this only after the backend owner supplies its reachable API endpoint.
EXPO_PUBLIC_API_URL=

# Server-only deployment configuration. Local pnpm db:run supplies DATABASE_URL
# from ~/.auth without writing credentials into a worktree or terminal output.
# Production uses a provisioned PostgreSQL URL and verified TLS, never local roles.
DATABASE_URL=
NODE_ENV=development

# Server-only names for the owning API/AI tasks. AI endpoints are loopback only.
API_HOST=127.0.0.1
API_PORT=
ADMIN_ORIGIN=
LUNA_BASE_URL=
LUNA_API_KEY=
LAYA_BASE_URL=

# Quality gates failed on synthetic holdouts. Enable only for scoped revalidation.
LUNA_REPORT_EXTRACTION_ENABLED=false
LAYA_ADVISORY_ENABLED=false
