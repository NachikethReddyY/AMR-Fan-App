FROM node:24.20.0-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e

ENV NODE_ENV=production \
    API_HOST=0.0.0.0 \
    API_PORT=8080

WORKDIR /app

# Copy workspace manifests first so dependency installation is reproducible and
# cached independently from application source changes.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/fan/package.json apps/fan/package.json
COPY apps/admin/package.json apps/admin/package.json
COPY services/api/package.json services/api/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/travel-domain/package.json packages/travel-domain/package.json

RUN corepack enable \
    && pnpm install --frozen-lockfile --ignore-scripts --prod --filter @amr/api...

# Keep runtime TypeScript, SQL migrations, shared contracts and the allowlisted
# admin assets available to the API. Tests and fixtures are removed by the
# root build-context policy in .dockerignore.
COPY packages/contracts packages/contracts
COPY packages/travel-domain packages/travel-domain
COPY services/api services/api
COPY apps/admin/pages apps/admin/pages

EXPOSE 8080
USER node
CMD ["node", "services/api/api/start.ts"]
